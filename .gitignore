# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/books/
/processing/

# design advisor reference (read-only, do not commit)
.design-ref/

# presentation build artifacts (large)
presentations/**/out/

# sc4sap plugin local logs/inventory (not project code)
.sc4sap/
docs/academy/validation/**/*.png

# ==== SAP HQ — migration (runtime + secrets, never commit) ====
SAP-HQ/incidents/
SAP-HQ/archive/
SAP-HQ/knowledge-graph/
.claude/skills/**/node_modules/
.claude/**/*.local
.claude/settings.local.json
**/.sc4sap/
**/sap.env
*.key
.env
.env.*
public/books/

# Generated by scripts/gen-sitemap.mjs during the build (see its header).
/public/sitemap.xml
screenshots/

# Generated during prebuild by scripts/gen-tx-search-index.mjs (derived data).
/public/tx-search-index.json
