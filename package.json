{
  "name": "sap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "gen:routes": "npx --yes tsx scripts/gen-route-manifest.mts",
    "check:routes": "node scripts/check-route-manifest.mjs",
    "crawl:deadlinks": "node scripts/crawl-dead-links.mjs",
    "verify:export": "node scripts/check-route-manifest.mjs && node scripts/crawl-dead-links.mjs",
    "migrate:books": "node scripts/migrate-books.mjs",
    "validate:books": "node scripts/validate-books.mjs",
    "audit:tree": "node scripts/audit-tree.mjs",
    "audit:library": "node scripts/audit-library.mjs",
    "build": "next build && node scripts/gen-sitemap.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "check:diag": "node scripts/check-diag.mjs",
    "prebuild": "node scripts/migrate-books.mjs && node scripts/validate-books.mjs && node scripts/build-ai-tree.mjs && npm run gen:tx-index",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:prod": "node scripts/check-prod.mjs",
    "check:vercel": "node scripts/check-vercel-json.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "gen:academy-blocks": "node --experimental-strip-types --no-warnings scripts/gen-academy-blocks.mjs",
    "check:academy-blocks": "node --experimental-strip-types --no-warnings scripts/gen-academy-blocks.mjs --check",
    "verify:reader": "node --experimental-strip-types scripts/verify-reader.mjs",
    "check:reader": "node scripts/check-reader-coverage.mjs",
    "gen:tx-index": "node --experimental-strip-types --no-warnings --loader ./scripts/alias-loader.mjs scripts/gen-tx-search-index.mjs",
    "verify:separation": "node scripts/verify-separation.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-visually-hidden": "^1.2.5",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "pdf-parse": "^2.4.5",
    "playwright-core": "1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
